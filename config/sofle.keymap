#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

// Thumb hold-taps. Keep this value easy to tune after real-world use.

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

&lt { tapping-term-ms = <200>; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | NAV/ESC | SPC/CTRL |  | ENTER | SYM/BSPC | CTRL | ALT | GUI |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                         &kp N6      &kp N7     &kp N8     &kp N9    &kp N0    &kp PAUSE_BREAK
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                          &kp Y       &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                          &kp H       &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B      &kp C_MUTE         &rgb_ug RGB_TOG  &kp N       &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL  &lt 2 ESC  &mt LCTRL SPACE    &kp RET          &lt 1 BSPC  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN &inc_dec_kp PG_UP PG_DN>;
            display-name = "base";
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  `  |  \  |  |   |  [   |  ]   |                   |  ^   |  &    |  *    |  (   |   )   |  F12  |
            // |       |  _  |  -  |  =   |  (   |  )   |                   |  !   |  @    |  #    |  $   |   %   |   |   |
            // |       |  <  |  >  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans             &kp F1     &kp F2     &kp F3     &kp F4    &kp F5                      &kp F6     &kp F7    &kp F8     &kp F9     &kp F10    &kp F11
&kp GRAVE          &kp GRAVE  &kp BSLH   &kp PIPE   &kp LBKT  &kp RBKT                    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &kp F12
&ext_power EP_TOG  &kp UNDER  &kp MINUS  &kp EQUAL  &kp LPAR  &kp RPAR                    &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT  &kp PIPE
&trans             &kp LT     &kp GT     &kp PLUS   &kp LBRC  &kp RBRC  &trans    &trans  &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH   &trans
                              &trans     &trans     &trans    &trans    &trans    &trans  &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
            display-name = "symbols";
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | W-LEFT|W-RIGHT| HOME | END  |                | PGUP | PGDN |       | HOME | END   |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                |  <-  |  v   |   ^   |  ->  | DEL   | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |W-LEFT|      |  |      |W-RIGHT|    |TAB-LEFT|TAB-RIGHT|DEL|       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4                    &trans         &trans     &trans         &trans         &trans   &trans
&trans      &kp INS       &kp LC(LEFT)  &kp LC(RIGHT)  &kp HOME      &kp END                         &kp PG_UP      &kp PG_DN  &trans         &kp HOME       &kp END  &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT      &trans        &kp CLCK                        &kp LEFT       &kp DOWN   &kp UP         &kp RIGHT      &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY     &kp K_PASTE   &kp LC(LEFT)  &trans    &trans  &kp LC(RIGHT)  &trans     &kp LC(PG_UP)  &kp LC(PG_DN)  &kp DEL  &trans
                          &trans        &trans         &trans        &trans        &trans    &trans  &trans         &trans     &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
            display-name = "nav";
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &tog 4  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none   &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none   &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none   &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none   &none  &none  &none
            >;

            display-name = "adjust";
        };

        game_layer {
            display-name = "game mode";
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                         &kp N6      &kp N7     &kp N8     &kp N9    &kp N0    &kp PAUSE_BREAK
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                          &kp Y       &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                          &kp H       &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B      &kp C_MUTE         &rgb_ug RGB_TOG  &kp N       &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL  &lt 5 ESC  &mt LCTRL SPACE    &kp RET          &lt 1 BSPC  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        game_raise_layer {
            bindings = <
&kp ENTER  &kp F1  &kp F2  &kp F3  &kp F5  &kp F9                    &tog 0  &trans  &trans  &trans  &trans  &trans
&kp M      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans  &trans  &trans  &trans  &trans  &trans
&kp I      &kp H   &kp J   &kp K   &kp L   &kp P                     &trans  &trans  &trans  &trans  &trans  &trans
&kp SPACE  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
